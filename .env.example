# =============================================================================
# EMAILJS CONFIGURATION
# =============================================================================
# 1. Sign up at https://www.emailjs.com/
# 2. Add an Email Service (e.g. Gmail) -> Copy "Service ID" below
# 3. Create an Email Template with variables:
#    {{from_name}}, {{from_email}}, {{subject}}, {{message}}
#    Copy "Template ID" below
# 4. In Account > Security & Keys -> Copy "Public Key" below
# 5. Restrict Allowed Domains in EmailJS Dashboard to prevent unauthorized usage!
# =============================================================================

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx
